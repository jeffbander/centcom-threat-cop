# Clerk (public + server)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Convex
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
# Optional during `npx convex dev` agent mode:
# CONVEX_AGENT_MODE=anonymous

# Convex dashboard: set CLERK_JWT_ISSUER_DOMAIN to your Clerk JWT template issuer
# (template name must be "convex", applicationID in auth.config.ts).

# Optional map flag — when true, UI can note a production map provider is ready.
# Never put map API secrets in NEXT_PUBLIC_*.
# NEXT_PUBLIC_MAP_PROVIDER_READY=true
# MAP_PROVIDER_API_KEY=

# X / Twitter API (app-only Bearer) — set on Convex dashboard as X_BEARER_TOKEN
# Never use NEXT_PUBLIC_* for this secret.
# X_BEARER_TOKEN=AAAAAAAAAAAAAAAAAAAA...

# App origin
NEXT_PUBLIC_APP_URL=http://localhost:3000
